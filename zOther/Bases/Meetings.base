views:
  - type: table
    name: Table
    filters:
      and:
        - meetingType != "standup"
        - type == "Meeting"
        - file.folder == "01. General/02. Meetings"
    order:
      - file.name
      - type
      - file.ctime
      - teams
      - projects
      - tags
      - summary
    sort:
      - property: file.ctime
        direction: DESC
    limit: 5
    columnSize:
      file.ctime: 148
