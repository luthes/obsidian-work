views:
  - type: table
    name: Table
    filters:
      and:
        - meetingType != "standup"
        - type == "Standup"
        - file.folder == "01. General/02. Meetings"
    order:
      - file.name
      - type
      - date
      - teams
      - projects
      - tags
      - summary
    sort:
      - property: file.name
        direction: ASC
    limit: 5
    columnSize: {}
